{
  "name": "examsetu-dtu",
  "version": "1.0.0",
  "description": "DTU ExamSetu Course Registration Automation",
  "main": "main.js",
  "author": {
    "name": "Sanchit",
    "email": ""
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.sanchit.examsetu-dtu",
    "productName": "ExamSetuDTU",
    "directories": {
      "output": "dist"
    },
    "files": ["**/*"],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "got": "^14.4.5",
    "node-notifier": "^10.0.1",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^24.6.0"
  }
}
